# Get a Blockfrost key from https://blockfrost.io
NEXT_PUBLIC_BLOCKFROST_KEY=your_blockfrost_key_here

# Network: preview, preprod, or mainnet
NEXT_PUBLIC_CARDANO_NETWORK=preview

# After deploying validators, fill these in:
NEXT_PUBLIC_TOKEN_POLICY=
NEXT_PUBLIC_CUSTODY_SCRIPT=
NEXT_PUBLIC_ISSUER_VK=
NEXT_PUBLIC_TRANSFER_SCRIPT=
NEXT_PUBLIC_THIRDPARTY_SCRIPT=
