      "display_text_range" : [
        "0",
        "291"
      ],
      "favorite_count" : "2",
      "in_reply_to_status_id_str" : "1875455366483312652",
      "id_str" : "1875532239808950758",
      "in_reply_to_user_id" : "97803921",
      "truncated" : false,
      "retweet_count" : "0",
      "id" : "1875532239808950758",
      "in_reply_to_status_id" : "1875455366483312652",
      "created_at" : "Sat Jan 04 13:18:26 +0000 2025",
      "favorited" : false,
      "full_text" : "@kostas_panagias @DanielJoeba This is truly one of the factors that i find difficult to grasp in PoS, 1c1v consensus.  It appears to be extremely disenfranchising for any new entrants to the space.  100k ADA at $0.24 is not equivalent to 100k at $3, but consensus weighs those as equal. 🤷‍♂️",
      "lang" : "en",
      "in_reply_to_screen_name" : "kostas_panagias",
      "in_reply_to_user_id_str" : "97803921"
    }
  },
  {
