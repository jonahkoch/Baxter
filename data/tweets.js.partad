      "created_at" : "Tue Feb 11 01:37:29 +0000 2025",
      "favorited" : false,
      "full_text" : "@shaggyrax @Hornan7 @adanorthpool You get back what you give, if we value governance as a voluntary commitment we will get exactly that.  People giving half their attention when they feel like showing up.  Those with intent good or bad will co-opt and dominate as voluntary efforts become unsustainable.",
      "lang" : "en",
      "in_reply_to_screen_name" : "shaggyrax",
      "in_reply_to_user_id_str" : "1587547778548391937"
    }
