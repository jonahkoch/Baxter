        ],
        "urls" : [ ]
      },
      "display_text_range" : [
        "0",
        "310"
      ],
      "favorite_count" : "0",
      "in_reply_to_status_id_str" : "1875532239808950758",
      "id_str" : "1875536270631563646",
      "in_reply_to_user_id" : "16304821",
      "truncated" : false,
      "retweet_count" : "0",
      "id" : "1875536270631563646",
      "in_reply_to_status_id" : "1875532239808950758",
      "created_at" : "Sat Jan 04 13:34:27 +0000 2025",
      "favorited" : false,
      "full_text" : "@kostas_panagias @DanielJoeba The idea in PoS is those with the most have the most at stake, thus incentivizing honest actors.  This trickles down to everything else.\nThat begs a lot of questions, because the intrinsic value of ADA is not equivalent in all situations, ie DEX custodial liquidity is an example.",
      "lang" : "en",
      "in_reply_to_screen_name" : "jonahkoch",
      "in_reply_to_user_id_str" : "16304821"
    }
  },
  {
    "tweet" : {
      "edit_info" : {
        "initial" : {
          "editTweetIds" : [
            "1875532239808950758"
          ],
          "editableUntil" : "2025-01-04T14:18:26.000Z",
          "editsRemaining" : "5",
          "isEditEligible" : false
        }
      },
      "retweeted" : false,
