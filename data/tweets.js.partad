        }
      },
      "retweeted" : false,
      "source" : "<a href=\"http://twitter.com/download/iphone\" rel=\"nofollow\">Twitter for iPhone</a>",
      "entities" : {
        "hashtags" : [ ],
        "symbols" : [ ],
        "user_mentions" : [ ],
        "urls" : [ ]
      },
      "display_text_range" : [
        "0",
        "279"
      ],
      "favorite_count" : "14",
      "id_str" : "1888596644616180085",
      "truncated" : false,
      "retweet_count" : "1",
      "id" : "1888596644616180085",
      "created_at" : "Sun Feb 09 14:31:43 +0000 2025",
      "favorited" : false,
      "full_text" : "Cardano is hamstrung by a scarcity mindset, constantly showing up a day late and a dollar short.  All while other (VC) chains throw monies around like they have an unlimited supply and they have outpaced Cardano on all metrics aside from decentralization.  \n\nThink like a winner!",
      "lang" : "en"
    }
  },
