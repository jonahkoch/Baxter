      },
      "retweeted" : false,
      "source" : "<a href=\"http://twitter.com/download/iphone\" rel=\"nofollow\">Twitter for iPhone</a>",
      "entities" : {
        "hashtags" : [ ],
        "symbols" : [ ],
        "user_mentions" : [ ],
        "urls" : [ ]
      },
      "display_text_range" : [
        "0",
        "264"
      ],
      "favorite_count" : "1",
      "id_str" : "1915952284187398300",
      "truncated" : false,
      "retweet_count" : "1",
      "id" : "1915952284187398300",
      "created_at" : "Sat Apr 26 02:13:15 +0000 2025",
      "favorited" : false,
      "full_text" : "I’m not in the financial world so I’m asking this truly as a question \n\nI don’t understand why an always expanding treasury (less expenditures than deposits) is deemed more fiscally responsible.\n\nFixed supply assets benefit from higher distribution = decrease risk",
      "lang" : "en"
    }
  },
